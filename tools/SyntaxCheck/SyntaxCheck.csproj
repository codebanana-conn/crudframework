<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Công cụ nội bộ (KHÔNG thuộc sản phẩm) dùng để rà soát cú pháp C# 5/6 cho
    CrudFramework.WinForms và CrudFramework.Sample trên máy Linux/CI không có
    DevExpress + Windows Desktop pack. Xem tools/SyntaxCheck/SyntaxCheck.cs.

    Tool này chạy trên .NET hiện đại (net8.0) CHỈ để dùng Roslyn parse; nó KHÔNG
    ảnh hưởng target net45 của các project sản phẩm.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SyntaxCheck</AssemblyName>
    <RootNamespace>SyntaxCheck</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

</Project>
